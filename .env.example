# ===========================================================================
# 环境变量模板 —— 复制为 .env 后按需修改
# 优先级：进程环境变量 > .env > config.py 默认值  |  修改后需重启服务
# 仅列出可能需要调整的项；其余参数沿用 config.py 默认值即可
# ===========================================================================

# --- 安全配置（必填）---
# CORS 允许的来源（逗号分隔），生产环境必须收敛到具体域名
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# JWT 密钥（必填，强随机字符串，至少 32 字符）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=please-change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 单管理员账号
JWT_ADMIN_USERNAME=admin
JWT_ADMIN_PASSWORD=please-change-me

# --- LLM（必填）---
# DeepSeek API Key：聊天 / 查询改写 / Ragas 评估均依赖此项
# 获取地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek:deepseek-v4-pro
# LLM 请求超时（秒）与最大重试次数
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- 嵌入模型（本地 ONNX INT8）---
# EMBEDDING_MODEL 必须与 EMBEDDING_DIM 严格对应，且 Milvus 集合维度需一致：
#   BAAI/bge-small-zh-v1.5 → 512   |   BAAI/bge-large-zh-v1.5 → 1024
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=25
# HuggingFace 镜像端点（国内无法直连 huggingface.co 时使用）
# 留空走官方源；默认使用 hf-mirror.com 镜像
HF_ENDPOINT=https://hf-mirror.com
# ONNX 缓存目录，缺省为 ~/.cache/finance_rag/onnx
# 如需自定义请使用绝对路径（勿用 ~ 前缀，留空走默认）
# ONNX_CACHE_DIR=/abs/path/to/onnx

# --- 向量数据库（Milvus）---
MILVUS_URI=http://localhost:19530
# 仅云托管或开启鉴权的 Milvus 需要，本地部署留空
MILVUS_TOKEN=
MILVUS_TIMEOUT_SECONDS=15
KB_COLLECTION_NAME=finance_kb

# --- 扫描版 PDF 云端 OCR（可选）---
# LlamaParse 回退解析扫描版 PDF；未配置则跳过云端 OCR
LLAMA_CLOUD_API_KEY=
SCAN_PDF_TEXT_THRESHOLD=50

# --- 文档切块 ---
# true → BAAI/bge-large-zh-v1.5（中文）；false → all-MiniLM-L6-v2（英文）
USE_ZH_TOKENIZER=false
DOCLING_CHUNK_MAX_TOKENS=512
PARENT_MAX_TOKENS=2000
CHILD_OVERLAP_TOKENS=50

# --- 混合检索（RRF）---
RRF_K=60
# 父文档存储路径，缺省为 ~/.cache/finance_rag/parent_store.db
# 如需自定义请使用绝对路径（勿用 ~ 前缀，留空走默认）
# PARENT_STORE_PATH=/abs/path/to/parent_store.db

# --- 重排序 ---
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# --- 问答链路 ---
CHAT_TOP_K=5
CHAT_RERANK_TOP_K=3
CHAT_ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_SIMILARITY_THRESHOLD=0.8
QUERY_REWRITE_MAX_ATTEMPTS=3

# --- 文档上传 ---
UPLOAD_DIR=./files
MAX_UPLOAD_SIZE_MB=20
DOCUMENT_PARSE_WORKERS=4
# Docling PDF 子进程硬超时；扫描版 PDF 需 OCR，默认 180 秒
PDF_PARSE_TIMEOUT_SECONDS=180

# --- Ragas 评估 ---
RAGAS_TIMEOUT_SECONDS=150
RAGAS_MAX_RETRIES=2
RAGAS_MAX_WORKERS=2

# --- RAG 优化开关（默认全部关闭，逐个启用验证效果）---
# 文档类型感知切块（根据文件名自动调整切块参数）
ENABLE_SMART_CHUNKER=false
# 多阶段检索管线（查询扩展 + 多路检索 + 去重 + 重排序）
ENABLE_MULTI_STAGE_RETRIEVAL=false
# 元数据过滤增强（检索支持按 source/title 等字段过滤）
ENABLE_METADATA_FILTER=false
# 金融专家角色 Prompt（结构化输出 + 风险提示）
ENABLE_FINANCIAL_EXPERT_PROMPT=false
# 引用验证机制（验证回答中引用是否与来源匹配）
ENABLE_CITATION_VALIDATION=false

# --- 高级调优（一般无需修改，取消注释以覆盖默认值）---
# MILVUS_NLIST=128
# MILVUS_NPROBE=10
# MULTI_STAGE_TOP_K=20
# MULTI_STAGE_EXPAND_COUNT=3
# CITATION_SIMILARITY_THRESHOLD=0.4
