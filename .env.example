# === LLM 配置 ===
# Copy this file to .env. This template is not loaded directly.
# Priority: process environment > .env > code defaults.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek:deepseek-v4-pro
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# === 嵌入配置 ===
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# === Milvus 配置 ===
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_TIMEOUT_SECONDS=15
KB_COLLECTION_NAME=finance_kb

# === 重排序配置 ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
# Global BGE reranker gate. Requests may disable reranking but cannot bypass false.
ENABLE_RERANKER=true

# === 切块配置 ===
# DOCLING_CHUNK_TOKENIZER 会根据 USE_ZH_TOKENIZER 自动选择，通常无需手动设置
# USE_ZH_TOKENIZER=true  → BAAI/bge-large-zh-v1.5（中文）
# USE_ZH_TOKENIZER=false → sentence-transformers/all-MiniLM-L6-v2（英文）
# 如需手动指定，取消下行注释：
# true forces BAAI/bge-large-zh-v1.5 and ignores DOCLING_CHUNK_TOKENIZER.
USE_ZH_TOKENIZER=false
DOCLING_CHUNK_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2
DOCLING_CHUNK_MAX_TOKENS=512

# === 混合检索权重 ===
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3

# === 问答配置 ===
CHAT_TOP_K=5
CHAT_RERANK_TOP_K=3
CHAT_ENABLE_QUERY_REWRITE=true

# === 查询改写配置 ===
QUERY_REWRITE_SIMILARITY_THRESHOLD=0.8
QUERY_REWRITE_MAX_ATTEMPTS=3

# === 评估配置 ===
RAGAS_TIMEOUT_SECONDS=150
RAGAS_MAX_RETRIES=2
RAGAS_MAX_WORKERS=2

# === 文档上传配置 ===
UPLOAD_DIR=./files
MAX_UPLOAD_SIZE_MB=20
DOCUMENT_PARSE_WORKERS=4

# === RAG 优化开关（默认全部关闭，保持原有行为） ===
# 统一中文 Tokenizer（切块使用 BAAI/bge-large-zh-v1.5）
USE_ZH_TOKENIZER=true

# 文档类型感知切块（根据文件名自动调整切块参数）
ENABLE_SMART_CHUNKER=false

# 多阶段检索管线（查询扩展 + 多路检索 + 去重 + 重排序）
ENABLE_MULTI_STAGE_RETRIEVAL=false

# 元数据过滤增强（检索支持按 source/title 等字段过滤）
ENABLE_METADATA_FILTER=false

# 金融专家角色 Prompt（结构化输出 + 风险提示）
ENABLE_FINANCIAL_EXPERT_PROMPT=false

# 引用验证机制（验证回答中引用是否与来源匹配）
ENABLE_CITATION_VALIDATION=false

# === 多阶段检索参数 ===
# MULTI_STAGE_TOP_K=20
# MULTI_STAGE_EXPAND_COUNT=3

# === 检索参数调优 ===
# MILVUS_NPROBE=10
# MILVUS_NLIST=128

# === 引用验证参数 ===
# CITATION_SIMILARITY_THRESHOLD=0.4
